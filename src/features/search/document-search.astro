---
import "src/features/search/document-search.scss";
const indexUrl = import.meta.env.BASE_URL.replace(/\/$/, "") + "/search-index.json";
---
<yeobaek-search data-index-url={indexUrl}>
  <button type="button" class="search-trigger" aria-label="글 검색" aria-haspopup="dialog" aria-controls="yeobaek-search-dialog">
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5" stroke-linecap="round"/></svg>
    <span>글 검색</span><kbd class="search-shortcut">Ctrl K</kbd>
  </button>
  <dialog id="yeobaek-search-dialog" class="search-dialog" aria-labelledby="search-dialog-title">
    <h2 id="search-dialog-title" class="search-sr-only">여백 글 검색</h2>
    <div class="search-bar">
      <label class="search-field">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5" stroke-linecap="round"/></svg>
        <input type="search" aria-label="검색어" placeholder="제목, 기술 이름, 키워드 검색" autocomplete="off" spellcheck="false" maxlength={100} />
      </label>
      <button type="button" class="search-close" aria-label="검색 닫기"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke-linecap="round"/></svg></button>
    </div>
    <div class="search-content">
      <div class="search-suggestions"></div>
      <div class="search-history"></div>
      <p class="search-status" role="status" aria-live="polite"></p>
      <ul class="search-results" aria-label="검색 결과"></ul>
    </div>
    <footer class="search-footer"><span><kbd>↑</kbd><kbd>↓</kbd> 이동</span><span><kbd>Enter</kbd> 선택한 글 열기</span><span><kbd>Esc</kbd> 닫기</span></footer>
  </dialog>
</yeobaek-search>

<script>
  import { navigate } from "astro:transitions/client";
  import { searchMatchStateKey, searchNavigation, type SearchMatchLocation } from "src/features/search/search-location";
  import { isSearchIndex, isMultiCharacterQuery, getMatchRanges, makeSearchPreview, normalizeSearch, recommendedQueries, relatedQueriesFromMatches, searchArticles, type SearchArticle } from "src/features/search/search-index";

  type QueryRecord = { query: string; lastUsed: number };
  const historyKey = "yeobaek-search-history-v1";
  const indexCache = new Map<string, Promise<SearchArticle[]>>();

  const readHistory = (): QueryRecord[] => {
    try {
      const parsed: unknown = JSON.parse(localStorage.getItem(historyKey) ?? "[]");
      if (!Array.isArray(parsed)) return [];
      return parsed.filter((item): item is QueryRecord =>
        typeof item === "object" && item !== null &&
        typeof item.query === "string" && item.query.trim().length > 0 && Number.isFinite(item.lastUsed)
      ).slice(0, 30);
    } catch {
      return [];
    }
  };

  const saveHistory = (query: string) => {
    const term = query.trim().slice(0, 100);
    if (!term) return;
    const records = readHistory();
    const remaining = records.filter((record) => normalizeSearch(record.query) !== normalizeSearch(term));
    const lastUsed = Math.max(Date.now(), ...records.map(record => record.lastUsed + 1));
    remaining.unshift({ query: term, lastUsed });
    try {
      localStorage.setItem(historyKey, JSON.stringify(remaining.sort((a, b) => b.lastUsed - a.lastUsed).slice(0, 30)));
    } catch { return; }
  };

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) => {
    const element = document.createElement(tag);
    if (className) element.className = className;
    if (text !== undefined) element.textContent = text;
    return element;
  };

  const appendHighlighted = (element: HTMLElement, text: string, query: string) => {
    let offset = 0;
    for (const range of getMatchRanges(text, query)) {
      element.append(document.createTextNode(text.slice(offset, range.start)), el("mark", "search-match", text.slice(range.start, range.end)));
      offset = range.end;
    }
    element.append(document.createTextNode(text.slice(offset)));
  };

  class YeobaekSearch extends HTMLElement {
    private articles: SearchArticle[] | undefined;
    private loadPromise: Promise<SearchArticle[]> | undefined;
    private dialog!: HTMLDialogElement;
    private trigger!: HTMLButtonElement;
    private input!: HTMLInputElement;
    private results!: HTMLUListElement;
    private status!: HTMLElement;
    private suggestions!: HTMLElement;
    private history!: HTMLElement;
    private content!: HTMLElement;
    private previousFocus: HTMLElement | null = null;
    private controller?: AbortController;
    private loadingError = false;
    private renderTimer: number | undefined;
    private renderedQuery = "";
    private queryVersion = 0;
    private renderedVersion = -1;
    private composing = false;

    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      this.dialog = this.querySelector("dialog")!;
      this.trigger = this.querySelector<HTMLButtonElement>(".search-trigger")!;
      this.input = this.querySelector("input")!;
      this.results = this.querySelector<HTMLUListElement>(".search-results")!;
      this.status = this.querySelector<HTMLElement>(".search-status")!;
      this.suggestions = this.querySelector<HTMLElement>(".search-suggestions")!;
      this.history = this.querySelector<HTMLElement>(".search-history")!;
      this.content = this.querySelector<HTMLElement>(".search-content")!;
      const shortcut = this.querySelector(".search-shortcut");
      if (shortcut) shortcut.textContent = /Mac|iPhone|iPad/.test(navigator.platform) ? "⌘ K" : "Ctrl K";
      this.trigger.addEventListener("click", () => this.open(this.trigger), { signal });
      this.querySelector(".search-close")?.addEventListener("click", () => this.dialog.close(), { signal });
      this.input.addEventListener("input", (event) => {
        this.queryVersion++;
        if (!this.composing && (!(event instanceof InputEvent) || !event.isComposing)) this.scheduleRender();
      }, { signal });
      this.input.addEventListener("compositionstart", () => {
        this.composing = true;
        this.queryVersion++;
        window.clearTimeout(this.renderTimer);
      }, { signal });
      this.input.addEventListener("compositionend", () => {
        this.composing = false;
        this.queryVersion++;
        this.scheduleRender();
      }, { signal });
      this.dialog.addEventListener("cancel", (event) => {
        if (this.composing) event.preventDefault();
      }, { signal });
      this.dialog.addEventListener("close", () => {
        if (this.dialog.open) return;
        window.clearTimeout(this.renderTimer);
        this.composing = false;
        this.previousFocus?.focus({ preventScroll: true });
        this.previousFocus = null;
      }, { signal });
      window.addEventListener("storage", (event) => {
        if ((event.key === historyKey || event.key === null) && this.dialog.open && !this.input.value.trim()) this.render();
      }, { signal });
      this.dialog.addEventListener("click", (event) => {
        if (event.target !== this.dialog) return;
        const rect = this.dialog.getBoundingClientRect();
        if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) this.dialog.close();
      }, { signal });
      this.dialog.addEventListener("keydown", (event) => this.onDialogKey(event), { signal });
      document.addEventListener("keydown", (event) => {
        if (this.composing || event.isComposing || event.keyCode === 229) return;
        if ((event.metaKey || event.ctrlKey) && !event.altKey && event.key.toLowerCase() === "k") {
          event.preventDefault();
          if (this.dialog.open) this.dialog.close();
          else this.open();
        }
      }, { signal });
    }

    disconnectedCallback() {
      this.controller?.abort();
      window.clearTimeout(this.renderTimer);
    }

    private scheduleRender() {
      window.clearTimeout(this.renderTimer);
      if (!this.dialog.open) return;
      this.renderTimer = window.setTimeout(() => this.render(), 90);
    }

    private open(focusTarget?: HTMLElement) {
      if (this.dialog.open) return;
      this.composing = false;
      this.queryVersion++;
      const active = document.activeElement;
      this.previousFocus = focusTarget ?? (active instanceof HTMLElement && active !== document.body ? active : this.trigger);
      this.dialog.showModal();
      this.input.focus({ preventScroll: true });
      this.input.select();
      this.render();
      void this.load();
    }

    private async load() {
      if (this.articles || this.loadPromise) return;
      this.loadingError = false;
      if (this.status.contains(document.activeElement)) this.input.focus({ preventScroll: true });
      this.render();
      const url = this.dataset.indexUrl;
      if (!url) {
        this.loadingError = true;
        this.render();
        return;
      }
      if (!indexCache.has(url)) {
        indexCache.set(url, fetch(url).then(async (response) => {
          if (!response.ok) throw new Error("검색 인덱스를 불러오지 못했습니다.");
          const payload: unknown = await response.json();
          if (!isSearchIndex(payload)) throw new Error("검색 인덱스 형식이 올바르지 않습니다.");
          return payload;
        }).catch((error) => { indexCache.delete(url); throw error; }));
      }
      this.loadPromise = indexCache.get(url);
      try {
        this.articles = await this.loadPromise;
      } catch {
        this.loadingError = true;
      } finally {
        this.loadPromise = undefined;
      }
      if (this.isConnected && this.dialog.open) this.render();
    }

    private isCurrentRender(query: string, version: number) {
      return this.isConnected && this.dialog.open && !this.composing && version === this.queryVersion && query === this.input.value.trim();
    }

    private chooseQuery(query: string) {
      this.queryVersion++;
      this.input.value = query;
      saveHistory(query);
      this.input.focus({ preventScroll: true });
      this.render();
    }

    private renderQueries(target: HTMLElement, label: string, values: string[], clearable = false) {
      const query = this.renderedQuery;
      const version = this.renderedVersion;
      const signature = JSON.stringify([label, values, version]);
      if (target.dataset.signature === signature) return;
      target.dataset.signature = signature;
      const active = document.activeElement;
      const focused = target.contains(active) && active instanceof HTMLButtonElement ? active.textContent : null;
      if (!values.length) {
        target.replaceChildren();
        if (focused && this.dialog.open) this.input.focus({ preventScroll: true });
        return;
      }
      const heading = el("div", "search-group-heading");
      heading.append(el("h3", undefined, label));
      if (clearable) {
        const clear = el("button", "search-clear-history", "기록 지우기");
        clear.type = "button";
        clear.addEventListener("click", () => {
          if (!clear.isConnected || !this.isCurrentRender(query, version)) return;
          try { localStorage.removeItem(historyKey); } catch { return; }
          this.render();
          this.input.focus();
        });
        heading.append(clear);
      }
      const chips = el("ul", "search-queries");
      for (const value of values) {
        const chip = el("button", "search-query", value);
        chip.type = "button";
        chip.addEventListener("click", () => {
          if (chip.isConnected && this.isCurrentRender(query, version)) this.chooseQuery(value);
        });
        const item = el("li");
        item.append(chip);
        chips.append(item);
      }
      target.replaceChildren(heading, chips);
      if (focused && this.dialog.open) {
        const button = [...target.querySelectorAll("button")].find(item => item.textContent === focused);
        (button ?? this.input).focus({ preventScroll: true });
      }
    }

    private render() {
      window.clearTimeout(this.renderTimer);
      if (this.composing) return;
      const query = this.input.value.trim();
      const matches = query && this.articles ? searchArticles(this.articles, query) : [];
      const changed = this.renderedQuery !== query;
      if (this.renderedVersion !== this.queryVersion && this.results.contains(document.activeElement)) this.input.focus({ preventScroll: true });
      this.renderedQuery = query;
      this.renderedVersion = this.queryVersion;
      const version = this.renderedVersion;
      if (changed) this.content.scrollTop = 0;
      if (!query) {
        this.renderQueries(this.suggestions, "추천 검색어", recommendedQueries);
        const recent = readHistory().sort((a, b) => b.lastUsed - a.lastUsed).slice(0, 5).map((entry) => entry.query);
        this.renderQueries(this.history, "검색 기록", recent, true);
      } else {
        this.renderQueries(this.history, "", []);
        this.renderQueries(this.suggestions, "연관 검색어", relatedQueriesFromMatches(matches, query));
      }
      if (this.loadingError) {
        this.results.replaceChildren();
        this.status.textContent = "검색을 불러오지 못했습니다. ";
        const retry = el("button", "search-retry", "다시 시도");
        retry.type = "button";
        retry.addEventListener("click", () => void this.load());
        this.status.append(retry);
        return;
      }
      if (!query || !this.articles) {
        this.results.replaceChildren();
        this.status.textContent = query ? "검색 준비 중…" : "관심 있는 기술이나 글의 제목을 검색해 보세요.";
        return;
      }
      const status = matches.length ? `${matches.length}개 글${isMultiCharacterQuery(query) ? "" : " · 결과를 선택해 열어 주세요."}` : "검색 결과가 없습니다. 다른 검색어를 입력해 보세요.";
      if (this.status.textContent !== status) this.status.textContent = status;
      const focusedId = document.activeElement?.closest<HTMLElement>(".search-results li")?.dataset.id;
      const existing = new Map([...this.results.children].map((item) => [(item as HTMLElement).dataset.id, item]));
      const items = document.createDocumentFragment();
      for (const { article, snippet, target, bodyMatches, titleMatches, matchedKeywords } of matches) {
        const item = (existing.get(article.id) as HTMLLIElement | undefined) ?? el("li");
        item.dataset.id = article.id;
        const link = item.querySelector<HTMLAnchorElement>("a") ?? el("a", "search-result");
        const anchor = target ? "#" + encodeURIComponent(target) : "";
        const range = bodyMatches && !titleMatches ? getMatchRanges(snippet, query)[0] : undefined;
        const matchedText = range ? snippet.slice(range.start, range.end) : "";
        const highlight = matchedText ? "?highlight=" + encodeURIComponent(matchedText) : "";
        link.href = article.url + highlight + anchor;
        const category = el("span", "search-result-category", article.category);
        const title = el("strong", "search-result-title");
        appendHighlighted(title, article.title, query);
        const summary = snippet || article.description;
        const preview = makeSearchPreview(summary, query);
        const description = el("span", "search-result-description");
        appendHighlighted(description, preview, query);
        link.replaceChildren(category, title);
        if (preview) link.append(description);
        if (!getMatchRanges(summary, query).length && !titleMatches && matchedKeywords.length) {
          const keywords = el("span", "search-result-keywords");
          keywords.append("관련 키워드 · ");
          appendHighlighted(keywords, matchedKeywords.join(" · "), query);
          link.append(keywords);
        }
        link.onclick = (event) => {
          if (!this.isCurrentRender(query, version)) {
            event.preventDefault();
            event.stopPropagation();
            if (this.isConnected && this.dialog.open && !this.composing) this.render();
            return;
          }
          saveHistory(query);
          if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
            this.dialog.close();
            return;
          }

          event.preventDefault();
          const destination = new URL(article.url, location.href);
          const match: SearchMatchLocation | undefined = matchedText
            ? { pathname: destination.pathname, query: matchedText.slice(0, 100), anchor: target }
            : undefined;
          // Astro only creates a history entry when the destination URL changes.
          if (destination.href === location.href) {
            if (!match) {
              this.dialog.close();
              return;
            }
            destination.searchParams.set("highlight", match.query);
          }
          const pending = window.setTimeout(() => {
            if (this.isCurrentRender(query, version)) this.status.textContent = "글 불러오는 중…";
          }, 180);
          void navigate(destination.href, {
            sourceElement: link,
            info: searchNavigation,
            state: match ? { [searchMatchStateKey]: match } : undefined,
          }).finally(() => {
            window.clearTimeout(pending);
            if (this.isCurrentRender(query, version)) this.render();
          });
        };
        link.onauxclick = (event) => {
          if (!this.isCurrentRender(query, version)) {
            event.preventDefault();
            event.stopPropagation();
          } else if (event.button === 1) saveHistory(query);
        };
        link.oncontextmenu = (event) => {
          if (!this.isCurrentRender(query, version)) event.preventDefault();
        };
        if (!item.contains(link)) item.append(link);
        items.append(item);
      }
      this.results.replaceChildren(items);
      if (focusedId && this.dialog.open) {
        const focused = [...this.results.querySelectorAll<HTMLAnchorElement>("a")].find(link => link.parentElement?.dataset.id === focusedId);
        (focused ?? this.input).focus({ preventScroll: true });
      }
    }

    private focusOption(option: HTMLElement) {
      option.focus({ preventScroll: true });
      if (!this.content.contains(option)) return;
      const item = option.getBoundingClientRect();
      const viewport = this.content.getBoundingClientRect();
      if (item.top < viewport.top + 4) this.content.scrollTop += item.top - viewport.top - 4;
      else if (item.bottom > viewport.bottom - 4) this.content.scrollTop += item.bottom - viewport.bottom + 4;
    }

    private onDialogKey(event: KeyboardEvent) {
      if (this.composing || event.isComposing || event.keyCode === 229 || event.altKey || event.ctrlKey || event.metaKey) return;
      if (event.key === "Escape") {
        event.preventDefault();
        this.dialog.close();
        return;
      }
      const stale = !this.isCurrentRender(this.renderedQuery, this.renderedVersion);
      if (stale && event.key === "Enter" && document.activeElement !== this.input) {
        event.preventDefault();
        this.input.focus({ preventScroll: true });
        this.render();
        return;
      }
      if (stale) this.render();
      const active = document.activeElement;
      if (event.key === "Enter" && active === this.input) {
        event.preventDefault();
        if (this.input.value.trim()) saveHistory(this.input.value);
        return;
      }
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
      event.preventDefault();
      const results = [...this.results.querySelectorAll<HTMLAnchorElement>("a")];
      const queries = [...this.content.querySelectorAll<HTMLButtonElement>(".search-query, .search-retry")];
      const options = active instanceof HTMLElement && queries.includes(active as HTMLButtonElement)
        ? [...queries, ...results]
        : results.length ? results : queries;
      if (!options.length) return;
      const index = options.findIndex(option => option === active);
      if (event.key === "ArrowDown") {
        this.focusOption(options[Math.min(index + 1, options.length - 1)]);
      } else if (index > 0) {
        this.focusOption(options[index - 1]);
      } else if (index === 0) {
        this.input.focus({ preventScroll: true });
      } else if (active === this.input) {
        this.focusOption(options[options.length - 1]);
      }
    }
  }

  if (!customElements.get("yeobaek-search")) customElements.define("yeobaek-search", YeobaekSearch);
</script>
