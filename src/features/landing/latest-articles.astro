---
import { getCollection } from "astro:content";
import { documentSections } from "src/features/navigation/document-sections.mjs";
import { articleDates, newestArticles } from "src/features/navigation/article-dates.mjs";

const catalog = new Set(documentSections.flatMap(section => section.chapters.flatMap(chapter => chapter.pages)));
const docs = await getCollection("docs", ({ id, data }) => catalog.has(id) && !data.draft);
const articles = newestArticles(docs.flatMap(({ id, data }) => {
  const dates = articleDates(id);
  return dates ? [{ id, title: data.title, ...dates }] : [];
}), 3);
---
<section class="archive-latest" aria-labelledby="latest-heading">
  <h2 id="latest-heading">최신 글</h2>
  {articles.map(article => (
    <a href={`./${article.id}/`}>
      <strong>{article.title}</strong>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
    </a>
  ))}
  {articles.length === 0 && <p>작성 이력을 확인할 수 있는 글이 없습니다.</p>}
</section>
