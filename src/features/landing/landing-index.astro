---
import { getCollection } from "astro:content";
import { documentSections } from "src/features/navigation/document-sections.mjs";
import "./landing-index.scss";

const docs = await getCollection("docs", ({ data }) => !data.draft);
const titles = new Map(docs.map(({ id, data }) => [id, data.title]));
const sections = documentSections.map(section => ({
  ...section,
  chapters: section.chapters.map(chapter => ({
    ...chapter,
    articles: chapter.pages.map(slug => {
      const title = titles.get(slug);
      if (!title) throw new Error(`목차에서 공개 글을 찾을 수 없습니다: ${slug}`);
      return { slug, title };
    }),
  })),
}));
const chapters = sections.flatMap(section => section.chapters);
const articleCount = chapters.reduce((count, chapter) => count + chapter.articles.length, 0);
---

<div class="chapter-heading">
  <h2 id="목차">목차</h2>
  <span>{chapters.length}개 장 · {articleCount}개 글</span>
</div>

<div class="chapter-index chapter-index--grouped">
  {sections.map(({id, title, chapters}) => (
    <section class="chapter-section" aria-labelledby={`section-${id}`}>
      <h3 id={`section-${id}`}>{title}</h3>
      <div class="chapter-section__chapters" data-columns={chapters.length}>
        {chapters.map(({number, title, description, articles}) => {
          const chapterId = `chapter-${Number(number)}`;
          return (
            <section class="chapter" aria-labelledby={chapterId}>
              <div class="chapter-intro">
                <div class="chapter-label">
                  <span aria-hidden="true">{number}</span>
                  <h4 id={chapterId}>{title}</h4>
                </div>
                <p>{description}</p>
              </div>
              <ul>
                {articles.map(({slug, title}) => <li><a href={`./${slug}/`}>{title}</a></li>)}
              </ul>
            </section>
          );
        })}
      </div>
    </section>
  ))}
</div>
