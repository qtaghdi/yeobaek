---
import { documentSections } from "src/features/navigation/document-sections.mjs";
import pencilHand from "./pencil-hand.webp";
import eraserHand from "./eraser-hand.webp";

const lettering: Record<string, string[]> = {
  프: ["M4 4q9 -3 19 -2", "M7 5l1 10", "M19 4l-2 11", "M4 17q8 -2 18 -2", "M2 26q13 -3 23 -3"],
  론: ["M5 3l16 -1l-2 6l-12 1l-1 5l16 -1", "M13 14l-1 6", "M2 21l23 -2", "M6 24l-1 6l16 -2"],
  트: ["M22 2L6 4L5 15l17 -2", "M7 9l12 -1", "M2 25q13 -3 23 -3"],
  엔: ["M8 4C3 3 1 9 3 13c3 5 8 3 9 -3c1 -4 -1 -6 -4 -6", "M12 9l5 -1", "M18 3l-1 16", "M23 1l-2 19", "M7 21l-2 9l17 -2"],
  드: ["M22 3L7 5L6 17l16 -2", "M2 25q11 -3 23 -3"],
  디: ["M14 4L5 5L3 19q5 1 11 -2", "M23 2q-3 13 -4 26"],
  자: ["M3 5q7 -2 13 -2", "M10 5Q8 16 2 21", "M9 11q3 5 7 7", "M23 2l-4 26", "M22 11l6 -1"],
  인: ["M9 3C4 3 1 10 3 14c3 6 10 1 11 -4c1 -4 -2 -7 -5 -7", "M23 3l-2 17", "M8 21l-2 9l17 -2"],
  접: ["M3 6l13 -3", "M10 5q-3 8 -8 13", "M9 10l7 6", "M15 10l7 -2", "M23 2l-2 17", "M6 21l-1 8l14 -2l2 -8", "M6 25l14 -2"],
  근: ["M5 4l17 -2l-5 11", "M2 17l23 -2", "M7 22l-1 8l16 -2"],
  성: ["M9 3q-1 8 -7 14", "M8 10l8 6", "M15 8l7 -2", "M24 1l-3 17", "M12 21c-7 0 -10 7 -3 9c7 2 13 -6 8 -9q-2 -1 -5 0"],
  렌: ["M4 4l11 -2l-2 6l-8 1l-1 6l10 -2", "M16 8l4 -1", "M21 3l-2 14", "M25 1l-2 17", "M7 22l-1 8l17 -3"],
  더: ["M13 4l-8 2l-2 17l11 -3", "M13 11l9 -2", "M24 2l-4 26"],
  링: ["M3 5l13 -2l-2 6l-9 1l-1 7l12 -2", "M24 2l-3 17", "M12 21c-7 0 -10 7 -3 9c7 2 13 -6 8 -9q-2 -1 -5 0"],
  테: ["M15 4l-10 2l-2 16l11 -2", "M5 13l8 -1", "M14 12l5 -1", "M20 3l-2 24", "M25 1l-2 26"],
  스: ["M14 4q-3 8 -11 14", "M12 9q4 5 10 7", "M2 26l23 -3"],
  a: ["M17 14C13 8 3 13 2 23C1 32 11 30 16 21", "M18 12l-2 17"],
  c: ["M17 13C10 6 2 15 2 23c0 8 9 8 15 2"],
  e: ["M3 21C19 18 19 9 12 11C5 12 1 19 2 25c1 6 9 6 15 1"],
  D: ["M5 4L3 29", "M6 4C31 -1 28 27 3 29"],
  v: ["M2 12L8 29l12 -18"],
  T: ["M2 5Q13 2 27 3", "M15 4l-3 25"],
  o: ["M13 11C5 10 1 18 2 25C3 32 14 31 17 23C19 17 17 12 13 11"],
  l: ["M7 3L4 25q-1 5 4 3"],
  s: ["M17 13C11 8 2 13 4 18c2 4 12 1 12 6c0 5 -9 8 -15 4"],
  C: ["M25 5C14 -2 4 7 3 20C2 30 13 34 23 25"],
  S: ["M23 6C15 -1 5 4 5 11c0 7 16 4 16 11c0 7 -11 10 -19 5"],
  R: ["M5 5L3 29", "M5 5C23 -2 27 13 6 17", "M8 17l15 12"],
  t: ["M12 6L8 25q-1 7 7 2", "M2 14l17 -2"],
  " ": [],
};

const advances: Record<string, number> = {
  D: 28, v: 24, T: 28, o: 22, l: 13, s: 21, " ": 11,
};
const topics = documentSections.flatMap(section => section.topics).map(text => {
  let offset = 0;
  const letters = Array.from(text, character => {
    const letter = { offset, strokes: lettering[character] };
    offset += advances[character] ?? 32;
    return letter;
  });
  return { text, letters };
});
---

<landing-note class="landing-note">
  <svg class="landing-notes" viewBox="0 -54 374 218" role="img" aria-label={"손글씨 메모, " + topics[0].text}>
    <defs>
      <clipPath id="landing-note-eraser">
        <rect class="landing-note__wipe" x="0" y="-54" width="374" height="218" />
      </clipPath>
      <clipPath id="landing-note-tools">
        <rect x="0" y="-54" width="374" height="218" />
      </clipPath>
      <filter id="landing-note-eraser-ink" x="-.1" y="-.1" width="1.2" height="1.2" color-interpolation-filters="sRGB">
        <feComponentTransfer><feFuncA type="linear" slope="2.6" intercept="-.045" /></feComponentTransfer>
      </filter>
      <filter id="landing-note-eraser-ink-dark" x="-.1" y="-.1" width="1.2" height="1.2" color-interpolation-filters="sRGB">
        <feComponentTransfer>
          <feFuncR type="linear" slope="-0.88" intercept="1" />
          <feFuncG type="linear" slope="-0.88" intercept="1" />
          <feFuncB type="linear" slope="-0.88" intercept="1" />
          <feFuncA type="linear" slope="3.4" intercept="-.045" />
        </feComponentTransfer>
      </filter>
    </defs>
    {topics.map(({ text, letters }, index) => (
      <g
        class="landing-note__ink"
        data-topic={text}
        lang={/^[A-Z]/.test(text) ? "en" : "ko"}
        opacity={index === 0 ? 1 : 0}
        clip-path="url(#landing-note-eraser)"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <g class="landing-note__writing">
          <g transform="translate(32 55) rotate(-4) scale(1.55)">
            <g class="landing-note__lettering" stroke-width="1.45">
              {letters.map(({ offset, strokes }) => (
                <g transform={`translate(${offset} 0)`}>
                  {strokes.map(stroke => <path d={stroke} />)}
                </g>
              ))}
            </g>
            <path class="landing-note__underline" d={index === 0 ? "M1 39C51 36 107 38 154 39" : undefined} stroke-width="1.2" />
          </g>
        </g>
      </g>
    ))}
    <g class="landing-note__crumbs" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
      {Array.from({ length: 13 }, (_, index) => (
        <path d={index % 2 ? "M-1.5 .1q1.5 -1 3 .55" : "M-2 0q1.7 1.8 3.7 .6"} opacity="0" />
      ))}
    </g>
    <g clip-path="url(#landing-note-tools)" aria-hidden="true">
      <g class="landing-note__hand" opacity="0">
        <image href={pencilHand.src} x="-24.5" y="-105.8" width="170" height="113.333" />
      </g>
      <g class="landing-note__eraser" opacity="0">
        <image href={eraserHand.src} x="-29.1" y="-104.8" width="168" height="112" />
      </g>
    </g>
  </svg>
  <button class="landing-note__toggle" type="button" aria-label="손글씨 애니메이션 일시 정지" hidden>
    <svg class="landing-note__pause" width="14" height="14" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5v10m6-10v10" /></svg>
    <svg class="landing-note__play" width="14" height="14" viewBox="0 0 20 20" aria-hidden="true"><path d="m7 5 8 5-8 5Z" /></svg>
  </button>
</landing-note>

<script>
  import "./landing-note";
</script>
