{
  "name": "yeobaek",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @yeobaek/docs dev",
    "storybook": "pnpm --filter @yeobaek/storybook dev",
    "build": "turbo run build",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "build-storybook": "pnpm --filter @yeobaek/storybook build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "prettier": "^3.9.10"
  }
}
